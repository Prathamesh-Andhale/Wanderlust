<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-md-6 offset-md-3">
    <div class="card shadow-sm p-4 text-center">
      <h3 class="text-primary mb-3"><i class="fa-solid fa-credit-card me-2"></i>Stripe Payment Simulator</h3>
      <p class="text-muted mb-4">
        You are in a development environment. We are simulating a credit card transaction via Stripe.
      </p>

      <div class="border rounded p-3 mb-4 text-start bg-light">
        <h5 class="border-bottom pb-2">Reservation Summary</h5>
        <p class="mb-1"><strong>Listing:</strong> <%= booking.listing.title %></p>
        <p class="mb-1"><strong>Location:</strong> <%= booking.listing.location %>, <%= booking.listing.country %></p>
        <p class="mb-1"><strong>Check-in:</strong> <%= booking.checkIn.toDateString() %></p>
        <p class="mb-1"><strong>Check-out:</strong> <%= booking.checkOut.toDateString() %></p>
        <p class="mb-1"><strong>Guests:</strong> <%= booking.numberOfGuests %> guest(s)</p>
        <p class="mb-0 fs-5 mt-2 text-danger fw-bold"><strong>Total Price:</strong> &#x20B9; <%= booking.totalPrice.toLocaleString("en-IN") %></p>
      </div>

      <form action="/bookings/<%= booking._id %>/mock-payment" method="POST">
        
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-danger btn-lg py-3"><i class="fa-solid fa-lock me-2"></i>Simulate Successful Payment</button>
          <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-secondary mt-2">Cancel Reservation</a>
        </div>
      </form>
    </div>
  </div>
</div>
