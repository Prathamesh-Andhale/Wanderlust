<% layout("/layouts/boilerplate") %>
<style>
  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid #ccc;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    background-color: #fff;
  }

  .filter.active-filter {
    border-bottom: 2px solid #fe424d;
    padding-bottom: 2px;
  }

  .filter:hover {
    opacity: 1 !important;
  }
</style>
<body>
  <!-- Filters Bar -->
  <div id="filters" class="d-flex flex-wrap justify-content-between align-items-center mt-3 mb-4">
    <div class="d-flex flex-wrap align-items-center">
      <% const categories = ["Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic"]; %>
      <% categories.forEach(cat => { %>
        <a href="/listings?category=<%= cat %>&priceMin=<%= priceMin %>&priceMax=<%= priceMax %>&location=<%= locationFilter %>" 
           class="filter text-decoration-none text-dark <%= selectedCategory === cat ? 'active-filter' : '' %>" 
           style="opacity: <%= selectedCategory === cat ? '1' : '0.6' %>; margin-top: 0.5rem; margin-right: 1.5rem; text-align: center; cursor: pointer;">
          <div>
            <% if (cat === 'Trending') { %><i class="fa-solid fa-fire"></i>
            <% } else if (cat === 'Rooms') { %><i class="fa-solid fa-bed"></i>
            <% } else if (cat === 'Iconic Cities') { %><i class="fa-solid fa-mountain-city"></i>
            <% } else if (cat === 'Mountains') { %><i class="fa-solid fa-mountain"></i>
            <% } else if (cat === 'Castles') { %><i class="fa-solid fa-fort-awesome"></i>
            <% } else if (cat === 'Amazing Pools') { %><i class="fa-solid fa-person-swimming"></i>
            <% } else if (cat === 'Camping') { %><i class="fa-solid fa-campground"></i>
            <% } else if (cat === 'Farms') { %><i class="fa-solid fa-cow"></i>
            <% } else if (cat === 'Arctic') { %><i class="fa-solid fa-snowflake"></i><% } %>
          </div>
          <p class="mb-0" style="font-size: 0.8rem; font-weight: 500;"><%= cat %></p>
        </a>
      <% }) %>
      
      <% if (selectedCategory) { %>
        <a href="/listings?priceMin=<%= priceMin %>&priceMax=<%= priceMax %>&location=<%= locationFilter %>" class="btn btn-sm btn-outline-secondary ms-2 mt-2">Clear Category</a>
      <% } %>
    </div>

    <div class="d-flex align-items-center mt-3 mt-lg-0">
      <button class="btn btn-outline-secondary me-3" type="button" data-bs-toggle="collapse" data-bs-target="#detailedFilters" aria-expanded="false">
        <i class="fa-solid fa-sliders me-1"></i>Filters
      </button>

      <div class="tax-toggle">
        <div class="form-check form-switch form-check-reverse mb-0">
          <input
            class="form-check-input"
            type="checkbox"
            role="switch"
            id="flexSwitchCheckDefault"
          />
          <label class="form-check-label small" for="flexSwitchCheckDefault"
            >Display total after taxes</label
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Detailed Filters Collapse -->
  <div class="collapse mb-4" id="detailedFilters">
    <div class="card card-body bg-light border-0 shadow-sm">
      <form action="/listings" method="GET" class="row g-3">
        <input type="hidden" name="category" value="<%= selectedCategory %>">
        
        <div class="col-md-3">
          <label for="priceMin" class="form-label small fw-medium">Min Price (&#x20B9;)</label>
          <input type="number" name="priceMin" id="priceMin" class="form-control" value="<%= priceMin %>" placeholder="0">
        </div>
        
        <div class="col-md-3">
          <label for="priceMax" class="form-label small fw-medium">Max Price (&#x20B9;)</label>
          <input type="number" name="priceMax" id="priceMax" class="form-control" value="<%= priceMax %>" placeholder="50,000">
        </div>

        <div class="col-md-4">
          <label for="location" class="form-label small fw-medium">Location / City</label>
          <input type="text" name="location" id="location" class="form-control" value="<%= locationFilter %>" placeholder="e.g., Jaipur">
        </div>

        <div class="col-md-2 d-flex align-items-end">
          <button type="submit" class="btn btn-danger w-100">Apply Filters</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Listings Grid -->
  <% if (allListings.length === 0) { %>
    <div class="text-center py-5">
      <p class="text-muted fs-5">No listings found matching the selected filters.</p>
      <a href="/listings" class="btn btn-danger">Reset All Filters</a>
    </div>
  <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1">
      <% for(let listing of allListings){ %>
      <a href="/listings/<%= listing._id%>" class="listing-link">
        <div class="card listing-card col">
          <img
            src="<%= listing.image && listing.image.length > 0 ? listing.image[0].url : 'https://images.unsplash.com/photo-1564501049412-61c2a3083791?q=80&w=2832&auto=format&fit=crop' %>"
            class="card-img-top"
            alt="listing_image"
            style="height: 20rem; object-fit: cover;"
          />
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%=listing.title%></b>
              <br />
              &#x20B9; <%=listing.price.toLocaleString("en-IN")%> / night
              <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
      <%}%>
    </div>
  <% } %>

  <!-- Pagination Controls -->
  <% if (totalPages > 1) { %>
  <nav aria-label="Page navigation" class="mt-4 mb-5">
    <ul class="pagination justify-content-center">
      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="/listings?page=<%= currentPage - 1 %>&limit=<%= limit %>&category=<%= selectedCategory %>&priceMin=<%= priceMin %>&priceMax=<%= priceMax %>&location=<%= locationFilter %>" aria-label="Previous">
          <span aria-hidden="true">&laquo;</span>
        </a>
      </li>
      <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
          <a class="page-link" href="/listings?page=<%= i %>&limit=<%= limit %>&category=<%= selectedCategory %>&priceMin=<%= priceMin %>&priceMax=<%= priceMax %>&location=<%= locationFilter %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="/listings?page=<%= currentPage + 1 %>&limit=<%= limit %>&category=<%= selectedCategory %>&priceMin=<%= priceMin %>&priceMax=<%= priceMax %>&location=<%= locationFilter %>" aria-label="Next">
          <span aria-hidden="true">&raquo;</span>
        </a>
      </li>
    </ul>
  </nav>
  <% } %>
</body>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");

  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");

    for (info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>
