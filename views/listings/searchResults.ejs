<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listings = <%- JSON.stringify(listings) %>;
</script>

<style>
  .card :hover {
    opacity: 80%;
  }
</style>

<div class="container mt-4">
  <div class="row">
    <div class="col-10 offset-1">
      <h2 class="mb-3">
        Search Results <% if (query && query.trim() !== "") { %> for "<%= query
        %>" <% } else { %> (All Listings) <% } %>
      </h2>

      <hr class="mt-3 mb-5" />

      <% if (listings.length === 0) { %>
      <p class="text-muted fs-5">No listings found.</p>
      <% } else { %>
      <div class="row g-4">
        <% listings.forEach(listing => { %>
        <div class="col-md-4">
          <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card listing-card h-100 shadow-sm">
              <img
                src="<%= listing.image.url %>"
                class="card-img-top"
                alt="listing_image"
                style="height: 18rem; object-fit: cover"
              />
              <div class="card-body">
                <p class="card-text">
                  <b><%= listing.title %></b><br />
                  &#x20B9; <%= listing.price.toLocaleString("en-IN") %> / night
                </p>
              </div>
            </div>
          </a>
        </div>
        <% }) %>
      </div>

      <% } %>
    </div>
  </div>

  <script src="/js/map.js"></script>
</div>
