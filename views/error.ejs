<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="alert alert-danger col-6 offset-3" role="alert">
    <p class="alert-handling"><b>Error:</b> <%=err.message%></p>
    <% if (err.stack) { %>
      <hr>
      <pre style="white-space: pre-wrap;"><%=err.stack%></pre>
    <% } %>
  </div>
</div>
